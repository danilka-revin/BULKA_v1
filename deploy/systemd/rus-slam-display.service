[Unit]
Description=RUS SLAM: экран запуска (PIN) на дисплее робота
Documentation=file:/opt/rus_slam/docs/RUN_AND_ACCESS.md
After=rus-slam-server.service
Wants=rus-slam-server.service
PartOf=graphical.target

[Service]
Type=simple

# Экран запуска: PIN 7232 — киоск оператора, 5656 — панель получателя.
ExecStart=/opt/rus_slam/deploy/systemd/display.sh http://127.0.0.1:8080/gate.html

Restart=always
RestartSec=3

# Графическая сессия дисплея робота: подставьте своего пользователя и дисплей.
Environment=DISPLAY=:0
User=rus

[Install]
WantedBy=graphical.target
